def fastq_r1(wildcards):
    return RNA_FASTQ_PAIRS[wildcards.sample]["R1"]


def fastq_r2(wildcards):
    return RNA_FASTQ_PAIRS[wildcards.sample]["R2"]


def input_read_for_mate(mate):
    if mate not in {"R1", "R2"}:
        raise ValueError(f"Unsupported FASTQ mate in RNA adapter contract: {mate!r}")

    def _input_read(wildcards):
        return fastq_r1(wildcards) if mate == "R1" else fastq_r2(wildcards)

    return _input_read


def darlin_output_targets():
    if not DARLIN_ENABLED:
        return []
    return [str(RESULTS_ROOT / "DARLIN" / "DARLIN_clone_id" / "DARLIN_Clone_ID.csv")]


