def resolve_sample_manifest_path():
    raw = config.get("sample_manifest", "00_config/sample_manifest.tsv")
    raw = str(raw).strip()
    if not raw or raw.lower() in {"none", "false", "null"}:
        raise ValueError("sample_manifest must point to 00_config/sample_manifest.tsv")

    path = Path(raw)
    path = path if path.is_absolute() else DATA_DIR / path
    if not path.is_file():
        raise ValueError(f"Sample manifest does not exist: {path}")
    return path.resolve()


def resolve_barcode_map_path():
    raw = config.get("barcode_map", "00_config/Barcode_Map.csv")
    path = Path(str(raw)).expanduser()
    path = path if path.is_absolute() else DATA_DIR / path
    if not path.is_file():
        raise ValueError(f"Project Barcode_Map.csv does not exist: {path}")
    return path.resolve()


