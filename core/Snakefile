def require_sample_id(row):
    sample_id = str(row["sample_id"]).strip()
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", sample_id):
        raise ValueError(
            "sample_manifest.tsv sample_id contains unsupported characters for Snakemake wildcards: "
            f"{sample_id!r}. Use only letters, numbers, underscore, dot, and dash."
        )
    return sample_id


def manifest_sample_ids(column):
    sample_ids = []
    seen = {}
    for row in SAMPLE_MANIFEST:
        raw_sample = row.get(column, "")
        if not raw_sample:
            continue
        sample_id = require_sample_id(row)
        previous = seen.get(sample_id)
        if previous and previous != raw_sample:
            raise ValueError(
                f"Duplicate sample_id {sample_id!r} would collide for {column} FASTQs: "
                f"{previous!r} and {raw_sample!r}"
            )
        if sample_id not in seen:
            sample_ids.append(sample_id)
            seen[sample_id] = raw_sample
    return sample_ids


RNA_RAW_DIR = resolve_project_path(config.get("raw_data_dir", "01_raw/RNA"))
RNA_RAW_FASTQ_PAIRS = require_fastq_pairs(
    RNA_RAW_DIR, "RNA", allow_empty=DARLIN_ENABLED
)
RNA_FASTQ_PAIRS = (
    map_fastq_pairs_to_manifest(
        RNA_RAW_FASTQ_PAIRS,
        SAMPLE_MANIFEST,
        column="rna_sample",
        label="RNA",
    )
    if RNA_RAW_FASTQ_PAIRS or any(row.get("rna_sample") for row in SAMPLE_MANIFEST)
    else {}
)


def discover_samples():
    if not RNA_FASTQ_PAIRS and DARLIN_ENABLED:
        return []
    samples = manifest_sample_ids("rna_sample")

    if not samples:
        if DARLIN_ENABLED:
            return []
        raise ValueError("No RNA samples found")

    missing = [sample for sample in samples if sample not in RNA_FASTQ_PAIRS]
    if missing:
        raise ValueError(
            "Configured RNA samples are missing paired FASTQ files: "
            + ", ".join(missing)
            + ". Update sample_manifest.tsv or raw_data_dir."
        )

    return samples


RNA_SAMPLES = discover_samples()

MANIFEST_BY_SAMPLE_ID = {require_sample_id(row): row for row in SAMPLE_MANIFEST}


