def resolve_data_dir():
    active = str(os.environ.get("RNA_DARLIN_CONFIG", "")).strip()
    if active:
        path = Path(active).expanduser().resolve()
    else:
        configfiles = list(getattr(workflow, "configfiles", []) or [])
        if not configfiles:
            raise ValueError(
                "RNA_DARLIN_Pipeline requires --configfile <project>/00_config/config.yaml"
            )
        path = Path(configfiles[-1]).expanduser().resolve()
    if path.name != "config.yaml" or path.parent.name != "00_config":
        raise ValueError(
            f"RNA_DARLIN_Pipeline only accepts <project>/00_config/config.yaml; found {path}"
        )
    return path.parent.parent.resolve()


DATA_DIR = resolve_data_dir()


def as_bool(value):
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() in {"1", "true", "yes", "y", "on"}
    return bool(value)


def as_list(value):
    if value is None:
        return []
    if isinstance(value, list):
        return value
    return [value]


def is_blank(value):
    return value is None or str(value).strip().lower() in {"", "none", "null", "false"}


def shell_args(args):
    return " ".join(shlex.quote(str(arg)) for arg in args)


